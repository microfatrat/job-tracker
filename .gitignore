# Rust 构建产物
/target
**/*.rs.bk

# 本地构建环境（WSL 下用到的 CARGO_HOME / 原生库前缀 / cargo 配置）
/.cargo-home
/.native
/.cargo/config.toml

# 打包输出
/dist
*.sha256

# 本地数据文件（用户数据目录之外的回退路径）
job_tracker_data.json
*.json.tmp

# 编辑器 / 系统文件
.idea/
.vscode/
.DS_Store

# SSH 密钥（避免误提交私钥）
.ssh/
id_ed25519*
id_rsa*
*.pem
*.key

# 数据文件的同目录备份（损坏备份 / 覆盖前备份）
*.bad-*.json
*.backup-*.json
*.reset-*.json
*.clear-*.json
